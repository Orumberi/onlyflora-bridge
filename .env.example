# Public HTTPS URL assigned by Timeweb, without a trailing slash.
APP_BASE_URL=https://your-app.example.com

# Webasyst account URL, without a trailing slash.
WEBASYST_ACCOUNT_URL=https://flora.webasyst.cloud
WEBASYST_CLIENT_ID=onlyflora-bridge
WEBASYST_CLIENT_NAME=OnlyFlora Bridge
WEBASYST_SCOPE=shop

# Generate with: openssl rand -base64 48
# Store only as a secret variable in Timeweb. Never commit the real value.
AUTH_SECRET=replace-with-at-least-32-random-characters

PORT=3000
NODE_ENV=production

# Optional comma-separated redirect origins. Defaults include ChatGPT/OpenAI.
# OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com,https://chat.openai.com
