# Add to the SAME Bridge deployment. No new Webasyst application is required.
EGOR_ENABLED=false
# Separate Webasyst OAuth credential belonging to a read-only Shop user.
EGOR_WEBASYST_TOKEN=
# Random preview access code of at least 32 characters. Keep only in host secrets.
EGOR_PREVIEW_KEY=
# Photo recognition. Never put these in the theme, HTML, git, or chat.
EGOR_OPENAI_KEY=
EGOR_OPENAI_MODEL=
