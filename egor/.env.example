# Add to the SAME Bridge deployment. No new Webasyst application is required.
EGOR_ENABLED=false
# Separate Webasyst OAuth credential belonging to a read-only Shop user.
EGOR_WEBASYST_TOKEN=
# Preferred for a Timeweb application hosted in Russia. Never put the key in
# the theme, HTML, git, or chat. Create it in Timeweb AI Gateway.
EGOR_TIMEWEB_AI_KEY=
EGOR_TIMEWEB_AI_MODEL=openai/gpt-4.1-mini
# Direct OpenAI fallback for deployments in a supported API region.
EGOR_OPENAI_KEY=
EGOR_OPENAI_MODEL=
